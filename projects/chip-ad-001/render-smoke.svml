<?svml using="@hypit/markup@1"?>
<svml>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="spatial" from="@hypit/spatial@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="text" from="@hypit/text-fine@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="style" source="./recipes.svs"/>

  <!-- Free local 3-second film-render smoke test. This is NOT the generated potato-chip ad. -->
  <time:Clock id="clock" frame-rate="24"/>
  <time:Timeline id="timeline" clock={clock} end="3s"/>
  <spatial:Canvas id="canvas" width="360" height="640"/>
  <spatial:Frame id="title-frame" within={canvas.bounds}
    left="6%" top="42%" right="94%" bottom="58%"/>
  <fonts:Face id="title-font" package="@fontsource-variable/inter" weight="900" style="normal"/>
  <text:Style id="title-style" recipe={style.text.title} font={title-font}/>
  <text:Flow id="title" timeline={timeline.timeline} within={title-frame}
    style={title-style} z="90" align="center" during={timeline.window}>
    CRUNCH!
  </text:Flow>
  <film:Film id="test-film" canvas={canvas.canvas} timeline={timeline.timeline}
    appearance={style.film.vertical}>
    <film:Track source={title.visual}/>
  </film:Film>
  <html:Video id="final" composition={test-film.composition} timeline={timeline.timeline}/>
</svml>
